# Jekyll 构建产物
_site/
_site-e2e/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# E2E 隔离目录（勿提交）
.e2e-staging/

# Ruby / Bundler
Gemfile.lock
.bundle/
vendor/

# 编辑器与 IDE
*.swp
*.swo
*~
.vscode/
.idea/
# Cursor 本地状态（rules 目录可提交）
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# 操作系统
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志与临时文件
*.log
*.tmp
*.temp

# 本地浏览器/DevTools 产物
.well-known/

# 注意：_data/build.yml intentionally tracked（首页版本号 date fallback，由 update-build-info.sh 更新，合并前须提交）
