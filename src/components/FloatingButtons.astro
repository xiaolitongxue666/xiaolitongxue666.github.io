---
import type { Post } from '../lib/posts';
import { getPostIndex } from '../lib/posts';
import { getAllPosts } from '../lib/posts';
import { getPaginationPageForPostIndex, getPageUrl } from '../lib/pagination';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const posts = getAllPosts();
const postIndex = getPostIndex(post, posts);
const paginationPage = getPaginationPageForPostIndex(postIndex);
const postDate = post.date.toISOString().slice(0, 10);
---

<meta name="post-date" content={postDate} />
<meta name="post-title" content={post.title} />
<meta name="pagination-page" content={paginationPage} />
<div class="floating-buttons">
  <button class="floating-btn back-to-top" id="back-to-top" title="回到顶部">↑</button>
  <a class="floating-btn back-to-pagination" id="back-to-pagination" title="回到分页">📄</a>
  <a class="floating-btn back-to-home" href={getPageUrl(1)} title="回到主页">🏠</a>
</div>
