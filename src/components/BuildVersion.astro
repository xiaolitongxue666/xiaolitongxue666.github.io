---
import { SITE } from '../lib/site';
import { getBuildInfo } from '../lib/build-info';

const buildInfo = getBuildInfo();
---

{
  buildInfo && (
    <div
      class="build-version"
      style="position:fixed;right:20px;bottom:16px;left:auto;z-index:900"
      title="站点版本（基于 Git commit）"
    >
      <a
        href={`https://github.com/${SITE.repository}/commit/${buildInfo.sha}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="build-version-id">v{buildInfo.commit}</span>
        {buildInfo.date && <span class="build-version-date">{buildInfo.date}</span>}
      </a>
    </div>
  )
}
