---
import { withBase } from '../lib/base';
---

<div class="github-info">
  <h3>GitHub Info</h3>
  <div class="github-profile">
    <img src="https://avatars.githubusercontent.com/u/35646108?v=4" alt="xiaolitongxue666" class="github-avatar" />
    <div class="github-details">
      <h4><a href="https://github.com/xiaolitongxue666" target="_blank">XiaoLi</a></h4>
      <p class="github-username">@xiaolitongxue666</p>
      <div class="github-stats">
        <div class="stat-item">
          <span class="stat-number">75</span>
          <span class="stat-label">Repos</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">37</span>
          <span class="stat-label">Followers</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">287</span>
          <span class="stat-label">Following</span>
        </div>
      </div>
      <div class="github-links">
        <div class="github-links-row">
          <a href="https://github.com/xiaolitongxue666" target="_blank" class="github-link">Visit GitHub</a>
          <a href={withBase('/stats/')} class="github-link github-link--stats">阅读统计</a>
        </div>
        <div class="footer-content">
          <p class="footer-text">𝓞𝓷 𝔂𝓸𝓾𝓻 𝓶𝓪𝓻𝓴</p>
        </div>
      </div>
    </div>
  </div>
</div>
