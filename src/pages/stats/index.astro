---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE } from '../../lib/site';
import { withBase } from '../../lib/base';

const publicStatsUrl = SITE.analytics.publicStatsUrl;
const homeUrl = withBase('/');
---

<PageLayout
  title="阅读统计"
  description="博客访问与阅读统计"
  keywords="阅读统计,访问量,xiaolitongxue666"
>
  <nav class="page-nav" aria-label="页面导航">
    <a href={homeUrl} class="page-nav-link">← 返回博客主页</a>
  </nav>

  <p class="stats-intro">
    以下为本博客的访问统计，数据由 VPS 自托管 GoatCounter 汇总（GitHub Pages 与 VPS 镜像共用），仅记录页面浏览量，不收集个人隐私信息。
  </p>

  <div class="stats-embed">
    <iframe
      id="stats-embed-frame"
      data-analytics-src={publicStatsUrl}
      title="博客阅读统计"
    ></iframe>
    <script is:inline>
      (function () {
        var iframe = document.getElementById('stats-embed-frame');
        if (!iframe) return;
        var base = iframe.getAttribute('data-analytics-src');
        if (!base) return;
        var theme = document.documentElement.getAttribute('data-theme');
        if (theme !== 'dark' && theme !== 'light') {
          try {
            theme = localStorage.getItem('theme');
          } catch (e) {
            theme = null;
          }
        }
        if (theme !== 'dark' && theme !== 'light') {
          theme = 'dark';
        }
        try {
          var url = new URL(base, window.location.href);
          url.searchParams.set('theme', theme);
          iframe.src = url.toString();
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
  </div>

  <div class="stats-fallback">
    <a
      href={publicStatsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="stats-fallback-link"
    >
      查看完整统计仪表盘
    </a>
  </div>

  <div class="floating-buttons">
    <button class="floating-btn back-to-top" id="back-to-top" title="回到顶部">↑</button>
    <a class="floating-btn back-to-home" href={homeUrl} title="回到主页">🏠</a>
  </div>

  <script src={withBase('/assets/js/stats-embed-theme.js')} is:inline></script>
</PageLayout>
