---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import Pagination from '../components/Pagination.astro';
import { formatPostDate, getAllPosts } from '../lib/posts';
import { getPostsForPage } from '../lib/pagination';
import { SITE } from '../lib/site';

const posts = getAllPosts();
const pagePosts = getPostsForPage(posts, 1);
---

<DefaultLayout
  title={SITE.title}
  description="Xiaolitongxue666's Blog"
  keywords="xiaolitongxue666"
  showSidebar={true}
  showBuildVersion={true}
>
  <div class="postlist">
    {pagePosts.map((post) => (
      <div class="overview">
        <div class="date">{formatPostDate(post.date)}</div>
        <div class="detail">
          <a href={post.url}>{post.title}</a>
        </div>
      </div>
    ))}
  </div>
  <Pagination currentPage={1} totalPosts={posts.length} />
</DefaultLayout>
